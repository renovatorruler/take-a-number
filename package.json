{
  "name": "take-a-number",
  "version": "1.0.0",
  "description": "Zero-friction queue management. No signup. No app. Just scan and wait.",
  "type": "module",
  "scripts": {
    "build:res": "rescript build",
    "build:bundle": "node build.mjs",
    "build": "npm run build:res && npm run build:bundle",
    "test": "npm run build:res && node lib/es6/tests/TestRunner.js",
    "test:watch": "npm run test",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "@rescript/core": "^1.6.1",
    "@rescript/react": "^0.14.0",
    "esbuild": "^0.27.2",
    "rescript": "^12.1.0"
  },
  "keywords": [
    "queue",
    "management",
    "qr-code",
    "preact",
    "gundb"
  ],
  "author": "",
